# Copy to .env.local for local development. Never commit real values.
# Backend API base URL (include /api)
VITE_API_URL=http://localhost:3000/api
# Socket.IO server URL (the backend origin, without /api)
VITE_SOCKET_URL=http://localhost:3000
# Max audio upload size in MB (must match MAX_AUDIO_MB on the backend)
VITE_MAX_AUDIO_MB=25
